<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- Server GC batches collections and makes deterministic unload assertions
             flaky. Workstation GC keeps the leak tests reliable. -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenAPI\OpenAPI.csproj" />
        <!-- Built before the tests, but deliberately NOT referenced: the leak plugin must
             only ever enter the process through a collectible AssemblyLoadContext. -->
        <ProjectReference Include="..\OpenAPI.Tests.LeakPlugin\OpenAPI.Tests.LeakPlugin.csproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
            <OutputItemType>LeakPluginOutput</OutputItemType>
        </ProjectReference>
    </ItemGroup>

    <!-- Drop it in a subfolder so it cannot be probed by the default load context. -->
    <Target Name="CopyLeakPlugin" AfterTargets="Build">
        <Copy SourceFiles="@(LeakPluginOutput)" DestinationFolder="$(OutDir)LeakPlugin\" />
    </Target>

</Project>
